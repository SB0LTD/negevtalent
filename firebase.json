{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/__call/setApplicationStatus",
        "function": { "functionId": "setApplicationStatus", "region": "europe-west1" }
      },
      {
        "source": "/__call/setApplicationMeeting",
        "function": { "functionId": "setApplicationMeeting", "region": "europe-west1" }
      },
      {
        "source": "/__call/listAdmins",
        "function": { "functionId": "listAdmins", "region": "europe-west1" }
      },
      {
        "source": "/__call/grantRole",
        "function": { "functionId": "grantRole", "region": "europe-west1" }
      },
      {
        "source": "/__call/revokeAdmin",
        "function": { "functionId": "revokeAdmin", "region": "europe-west1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|gif|webp|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
